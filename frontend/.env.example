# Copy to .env in this directory: cp .env.example .env

# Backend API base URL (axios). Leave empty to use Vite dev proxy with relative /api paths.
VITE_API_URL=http://localhost:8080

# Vite dev server proxy target for /api and /ws
VITE_API_PROXY_TARGET=http://localhost:8080

# Vite dev server port
VITE_DEV_PORT=5173
