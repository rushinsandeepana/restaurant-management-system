# Copy to .env in this directory: cp .env.example .env

# PostgreSQL (docker-compose + local JDBC)
POSTGRES_DB=rms
POSTGRES_USER=rms
POSTGRES_PASSWORD=rms
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rms
SPRING_DATASOURCE_USERNAME=rms
SPRING_DATASOURCE_PASSWORD=rms

# API server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT (min 32 characters in production)
JWT_SECRET=rms-dev-secret-change-in-production-min-32-chars!!

# CORS — comma-separated frontend origins
RMS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
